{
  "name": "globnotes (deno)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  // Keep these caps equal to DEV_CAPS in run.sh.
  "runArgs": ["--memory=8g", "--memory-swap=8g", "--pids-limit=512", "--cpus=4"],
  "remoteUser": "dev",
  "containerUser": "dev",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": ["denoland.vscode-deno"]
    }
  }
}
