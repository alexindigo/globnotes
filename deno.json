{
  "tasks": {
    "dev": "deno run --watch --unstable-worker-options --allow-net --allow-read --allow-write --allow-env server/main.ts",
    "start": "deno run --unstable-worker-options --allow-net --allow-read --allow-write --allow-env server/main.ts",
    "test": "deno test --unstable-worker-options --allow-read --allow-write --allow-env tests/",
    "check": "deno check server/main.ts tests/**/*.ts",
    "lint": "deno lint server/ tests/",
    "fmt": "deno fmt"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@std/fs": "jsr:@std/fs@^1.0.20",
    "@std/path": "jsr:@std/path@^1.1.3"
  },
  "fmt": {
    "include": ["server/", "tests/"]
  },
  "lint": {
    "include": ["server/", "tests/"]
  },
  "test": {
    "include": ["tests/"]
  }
}
